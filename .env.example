# Turso / libSQL (use file:./local.db for local development)
DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# OpenRouter
OPENROUTER_API_KEY=

# Anonymous identity signing (generate each independently, e.g. openssl rand -base64 32)
ANON_TOKEN_SECRET=
ANON_SALT=

# Better Auth (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Social sign-in (optional; buttons hidden when unset)
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
#   Authorization callback URL: {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Model administration (/admin/models) — comma-separated e-mails
ADMIN_EMAILS=

# Stripe billing (https://dashboard.stripe.com)
# 1. STRIPE_SECRET_KEY — sk_test_/sk_live_ key for the account
# 2. Create one recurring EUR price per paid plan (IVA included in the price,
#    e.g. Plus 5,99 €/mês) and store the price IDs (price_…) centrally via the
#    launch settings (plusStripePriceIdMonthly / proStripePriceIdMonthly /
#    ultraStripePriceIdMonthly). Checkout fails closed while a plan's ID is unset.
# 3. STRIPE_WEBHOOK_SECRET — whsec_… of the webhook endpoint pointing at
#    {APP_URL}/api/webhooks/stripe subscribing to:
#      checkout.session.completed
#      customer.subscription.created / .updated / .deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canonical app URL (HTTPS is required when NODE_ENV=production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Search ownership (optional). Add the verification tokens from each console.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional IndexNow key: 8–128 letters, numbers or hyphens. After deployment,
# run `pnpm seo:indexnow` whenever public canonical content changes.
INDEXNOW_KEY=
